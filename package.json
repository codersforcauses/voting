{
  "name": "openvote",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "api",
    "client"
  ],
  "scripts": {
    "dev": "bun --elide-lines=0 --filter api dev",
    "dev:client": "bun --filter client dev",
    "dev:all": "bun run --parallel dev dev:client",
    "build": "bun run build:api && bun run build:client",
    "build:api": "bun --filter api build",
    "build:client": "bun --filter client build",
    "start": "bun --filter api start",
    "test": "bun --filter api test",
    "db:generate": "bun --filter api db:generate",
    "db:migrate": "bun --filter api db:migrate",
    "db:studio": "bun --filter api db:studio",
    "typecheck": "bun --filter api typecheck && bun --filter client typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "postgres": "^3.4.7"
  }
}
