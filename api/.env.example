# Database Configuration
# For local development with PostgreSQL
DATABASE_URL=postgres://localhost:5432/openvote

# For local development with SQLite (alternative)
# DATABASE_URL=./voting.db

# Authentication
# Generate with: openssl rand -base64 32
AUTH_SECRET_KEY=your-secret-key-here

# Clerk Authentication (optional, for OAuth)
CLERK_SECRET_KEY=your-clerk-secret-key

# Initial Access
# Master seat code for first-time setup
INIT_SEAT=your-initial-seat-code

# Environment
ENVIRONMENT=dev

# Server Configuration
PORT=3000
HOST=0.0.0.0

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
