{
  "name": "api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "build:binary": "bun build src/index.ts --compile --outfile openvote",
    "start": "bun src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun src/models/seed.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/backend": "^1.25.3",
    "@hono/zod-validator": "^0.4.3",
    "drizzle-orm": "^1.0.0-beta.6-7aaf14b",
    "drizzle-zod": "^0.7.0",
    "hono": "^4.7.5",
    "jose": "^5.9.6",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/bun": "^1.3.5",
    "drizzle-kit": "^1.0.0-beta.6-7aaf14b",
    "drizzle-seed": "^1.0.0-beta.6-7aaf14b",
    "typescript": "^5.8.2"
  }
}
